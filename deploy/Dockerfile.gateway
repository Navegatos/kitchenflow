# Gateway: build del front + nginx (SPA + reverse proxy al backend).
# Contexto de build: raíz del repositorio.

FROM node:20-bookworm-slim AS front-build

WORKDIR /app

COPY front/package.json front/package-lock.json ./
RUN npm ci

COPY front/ .

ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=front-build /app/dist /usr/share/nginx/html

ARG NGINX_CONF=prod
COPY deploy/nginx/${NGINX_CONF}.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

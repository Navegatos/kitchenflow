# Copiar a prod.env y reemplazar los valores marcados con CHANGE_ME.
# cp deploy/env/prod.env.example deploy/env/prod.env

# Puerto HTTP expuesto por el gateway (nginx)
HTTP_PORT=80

# PostgreSQL (solo red interna de Docker; no se publica al host)
POSTGRES_USER=kitchenflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=kitchenflow

# Backend — generar un secreto aleatorio largo (p. ej. openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS

# Orígenes permitidos por CORS (URL pública del front, sin barra final)
# Con el gateway nginx las peticiones van same-origin; conviene igualmente
# definir el dominio real por si accedes a la API directamente.
CORS_ORIGINS=https://kitchenflow.example.com

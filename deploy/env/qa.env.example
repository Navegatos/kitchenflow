# Copiar a qa.env antes de levantar el entorno QA.
# cp deploy/env/qa.env.example deploy/env/qa.env

# Puerto HTTP de la aplicación (gateway nginx)
HTTP_PORT=8090

# PostgreSQL expuesto para herramientas externas (DBeaver, psql, etc.)
POSTGRES_PORT=5433
POSTGRES_USER=kitchenflow
POSTGRES_PASSWORD=kitchenflow_qa_change_me
POSTGRES_DB=kitchenflow

# Backend
JWT_SECRET_KEY=qa-jwt-secret-change-me-before-shared-deploy

# Orígenes CORS (URL del gateway QA)
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Adminer — UI web para inspeccionar la BD
ADMINER_PORT=8081
